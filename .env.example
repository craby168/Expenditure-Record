# Copy to .env, set your actual HTTPS origin, and protect the file.
# This file contains configuration only. There are NO default accounts/passwords.
APP_PUBLIC_ORIGIN=https://expenses.example.com

# Host NAS path. Pre-create it and allow UID/GID 10001 to read/write.
# Example Synology path: /volume1/docker/expense-records/data
DATA_DIR=./nas-data

# Publish only on host loopback by default; NAS HTTPS reverse proxy targets this.
HOST_BIND=127.0.0.1
HOST_PORT=8080
APP_SESSION_IDLE_SECONDS=1800
APP_SESSION_MAX_SECONDS=43200

# Local Python development only (not used by production Compose):
# APP_DEV_LOCALHOST=1
# APP_PUBLIC_ORIGIN=http://127.0.0.1:8080
# APP_HOST=127.0.0.1
# APP_PORT=8080
# APP_DATA_DIR=./nas-data
